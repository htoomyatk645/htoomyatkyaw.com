{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "htoomyatkyaw-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // Static site (the mirrored + rebranded portfolio).
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/_v2/*", "/_ext/framerusercontent.com/cms/*", "/case-study/*", "/blog/*", "/case-study", "/blog", "/services", "/services/*"]
  },

  "routes": [
    { "pattern": "htoomyatkyaw.com", "custom_domain": true },
    { "pattern": "www.htoomyatkyaw.com", "custom_domain": true }
  ],

  // Contact form -> inbox. Requires Email Routing on htoomyatkyaw.com with
  // htoo.m.kyaw645@gmail.com added and verified as a destination address.
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "htoo.m.kyaw645@gmail.com" }
  ],
  "vars": {
    "CONTACT_TO": "htoo.m.kyaw645@gmail.com",
    "CONTACT_FROM": "contact@htoomyatkyaw.com",
    "ALLOWED_ORIGINS": "https://htoomyatkyaw.com,https://www.htoomyatkyaw.com"
  },

  // 5 submissions per minute per IP.
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
